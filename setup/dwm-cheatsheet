#!/bin/sh

# 1. Padding block adjusted to make every single arrow line up perfectly at character index 12
bindings="󰘳 p         → Launch dmenu
󰘳 ⇧ ↩       → Open Terminal
󰄀 Print     → Take Screenshot
󰘳 b         → Toggle Status Bar
󰘳 j         → Focus Next Window
󰘳 k         → Focus Prev Window
󰘳 ⇧ j       → Move Window Down Stack
󰘳 ⇧ k       → Move Window Up Stack
󰘳 h         → Shrink Master Area
󰘳 l         → Expand Master Area
󰘳 i         → Increase Master Count
󰘳 d         → Decrease Master Count
󰘳 ↩         → Master Zoom / Cycle
󰘳 󰘔         → Focus Last Tag/Workspace
󰘳 ⇧ c       → Close/Kill Window
󰘳 t         → Layout: Tiled
󰘳 f         → Layout: Float
󰘟 m         → Layout: Monocle
󰘳 Space     → Toggle Previous Layout
󰘳 ⇧ Space   → Toggle Floating State
󰘳 ,         → Focus Previous Monitor
󰘳 .         → Focus Next Monitor
󰘳 ⇧ ,       → Send Window to Prev Mon
󰘳 ⇧ .       → Send Window to Next Mon
󰘳 1         → View Workspace 1 [💻]
󰘳 2         → View Workspace 2 [ ]
󰘳 3         → View Workspace 3 [🌐]
󰘳 4         → View Workspace 4 [ ]
󰘳 5         → View Workspace 5 [🛠️]
󰘳 ⇧ 1       → Send Window to Tag 1
󰘳 ⇧ 2       → Send Window to Tag 2
󰘳 ⇧ 3       → Send Window to Tag 3
󰘳 ⇧ 4       → Send Window to Tag 4
󰘳 ⇧ 5       → Send Window to Tag 5
󰘳 0         → View All Workspaces
󰘳 ⇧ 0       → Tag Window to All Workspaces
󰘳 ⇧ q       → Quit / Exit DWM"

# 2. Rofi Display Engine
echo "$bindings" | rofi -dmenu -p "" \
  -font "ComicShannsMono Nerd Font 10.5" \
  -location 5 -xoffset -20 -yoffset -20 \
  -kb-cancel "Alt+slash" \
  -no-lazy-grab \
  -kb-custom-1 "a,b,c,d,e,f,g,i,j,k,m,n,o,p,q,r,s,t,u,v,w,x,y,z,1,2,3,4,5,6,7,8,9,0" \
  -kb-custom-2 "Alt+h" \
  -kb-custom-3 "Alt+l" \
  -theme-str '
        window { 
            width: 310px; /* Slight bump to prevent truncated labels on the right */
            height: 520px; /* Expanded window height constraint */
            anchor: south east; 
            background-color: #020914; 
            border: 1px; 
            border-color: #63576E; 
            border-radius: 8px; 
            padding: 12px;
        } 
        inputbar {
            enabled: false;
        }
        entry {
            enabled: false;
        }
        listview { 
            lines: 16; 
            scrollbar: false;
            fixed-height: false;
            dynamic: true;
            background-color: transparent;
            border: 0px;
            spacing: 2px;
        } 
        element {
            padding: 4px 6px;
            border: 0px;
            background-color: transparent;
        }
        element alternate normal {
            background-color: transparent;
        }
        element normal normal {
            background-color: transparent;
        }
        element selected { 
            background-color: transparent; 
        }
        element-text {
            background-color: transparent;
            text-color: #f1be9b;
            horizontal-align: 0.0;
        }
    '

exit 0
